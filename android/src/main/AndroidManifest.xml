<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.livespeechrecorder.live_speech_recorder">

    <!-- Microphone permission for single AudioRecord capture session -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Internet permission for online recognition backend if requested -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Queries to bind and query Android Speech Recognition Services on Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
